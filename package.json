{
  "name": "gestioncomercial",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @gc/api dev",
    "dev:web": "pnpm --filter @gc/web dev",
    "db:migrate": "pnpm --filter @gc/api db:migrate",
    "db:generate": "pnpm --filter @gc/api db:generate",
    "e2e": "node e2e/nucleo.e2e.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "playwright": "1.63.0"
  }
}
