{
  "name": "gestioncomercial",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @gc/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @gc/web dev",
    "catalog": "pnpm --filter @gc/contracts export-catalog",
    "e2e": "node e2e/nucleo.e2e.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "playwright": "1.63.0"
  }
}
