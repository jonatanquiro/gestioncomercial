# Copiar a .env y completar. Nunca subir .env al repositorio.

# ── Obligatorias ─────────────────────────────────────────────
# Clave de 32 bytes en base64 para cifrar secretos (TOTP y, en la Fase 5, certificados ARCA).
# Generarla con:  openssl rand -base64 32
# Cambiarla invalida los secretos cifrados existentes.
APP_ENCRYPTION_KEY=

# Conexión de la API. Usa el rol gc_app (sin permisos propios; ver infra/postgres/init.sql).
DATABASE_URL=postgres://gc_app:gc_app@localhost:5432/gestioncomercial

# Conexión para migraciones con el rol dueño gc_owner. La API nunca la usa.
DATABASE_MIGRATION_URL=postgres://gc_owner:gc_owner@localhost:5432/gestioncomercial

# ── Opcionales (valor por defecto entre paréntesis) ──────────
# development | test | production  (development)
NODE_ENV=development
# Puerto HTTP de la API  (3000)
PORT=3000
# URL pública de la web; se usa en los enlaces de los correos  (http://localhost:5173)
APP_URL=http://localhost:5173
# Cookies con atributo Secure  (true en production, false en el resto)
# COOKIE_SECURE=false
# SMTP para correos. Obligatorio en production. En desarrollo: Mailpit del docker compose.
# Sin valor en desarrollo, los correos se escriben en el log.
SMTP_URL=smtp://localhost:1025
# Remitente de los correos
MAIL_FROM=Gestión Comercial <no-responder@localhost>
# Carpeta con la web compilada para servirla desde la API (la imagen Docker la define sola)
# WEB_DIST_DIR=../web/dist
# fatal | error | warn | info | debug | trace | silent  (info)
LOG_LEVEL=info

# ── Solo docker compose ──────────────────────────────────────
# Contraseñas de los roles de base locales (deben coincidir con infra/postgres/init.sql)
# POSTGRES_PASSWORD=postgres
# GC_OWNER_PASSWORD=gc_owner
# GC_APP_PASSWORD=gc_app
# Puertos publicados en el equipo
# APP_PORT=3000
# DB_PORT=5432
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# ── Solo para crear un administrador de plataforma ───────────
# PLATFORM_ADMIN_PASSWORD=
