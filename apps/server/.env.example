# Configuración del servidor. Copiar a .env (nunca se sube al repositorio) y ajustar.
# En XAMPP alcanza con crear la base y correr: php artisan key:generate && php artisan migrate

APP_NAME="Gestión Comercial"
# local | testing | production
APP_ENV=local
# Clave de cifrado (cookies, secretos TOTP y, en la Fase 5, certificados ARCA).
# Se genera con: php artisan key:generate   — cambiarla invalida los secretos guardados.
APP_KEY=
# true solo en desarrollo: muestra detalles de errores
APP_DEBUG=true
# URL con la que se entra al sistema; se usa en los enlaces de los correos
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos MySQL o MariaDB (la de XAMPP: usuario root sin contraseña).
# En producción, usar un usuario propio con contraseña y sin permisos sobre otras bases.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestioncomercial
DB_USERNAME=root
DB_PASSWORD=

# Base usada por las pruebas automáticas (se borra y recrea en cada corrida)
DB_TEST_DATABASE=gestioncomercial_test

# El sistema usa sus propias sesiones (tabla user_sessions); la sesión de Laravel no se usa.
SESSION_DRIVER=array
# Cookies con atributo Secure: true en producción con HTTPS
SESSION_SECURE_COOKIE=false

# Caché en la base: la usa el limitador de intentos de ingreso
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Correo. "log" escribe los correos en storage/logs/laravel.log (útil en XAMPP sin servidor de correo).
# Para probar con Mailpit: MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@localhost"
MAIL_FROM_NAME="${APP_NAME}"
