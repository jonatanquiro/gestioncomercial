{
  "name": "@gc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "dev": "node --env-file-if-exists=../../.env --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env -r @swc-node/register src/scripts/migrate.ts",
    "platform:create-admin": "node --env-file-if-exists=../../.env -r @swc-node/register src/scripts/create-platform-admin.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.7",
    "@gc/contracts": "workspace:*",
    "@gc/domain": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.11.3",
    "nodemailer": "10.2.1",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
